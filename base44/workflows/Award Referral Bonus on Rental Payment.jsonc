{
  "name": "Award Referral Bonus on Rental Payment",
  "description": "Triggers when a rental payment is successfully completed. Awards referral bonus points to both referrer and borrower if this is the borrower's first rental payment.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"Successful\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "RentalPaymentTransaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "award_referral_bonus_on_rental_payment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "referralEngine",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "referralEngine"
  }
}