{
  "name": "Notify Lenders \u2014 New P2P Loan Listed",
  "description": "Fires when a P2P loan is listed on the marketplace (status = awaiting_funding + is_marketplace_listed = true). Calls notifyLendersForNewLoans to fan out in-app alerts to matching lenders.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"awaiting_funding\") and (.trigger.data.is_marketplace_listed == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "P2PLoan"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_lenders_new_p2p_loan_listed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyLendersForNewLoans",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyLendersForNewLoans"
  }
}