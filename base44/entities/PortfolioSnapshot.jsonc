{
  "name": "PortfolioSnapshot",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "total_value": {
      "type": "number"
    },
    "total_invested": {
      "type": "number"
    },
    "total_returns": {
      "type": "number"
    },
    "return_rate": {
      "type": "number"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "allocation_breakdown": {
      "type": "object"
    }
  },
  "required": [
    "user_id",
    "snapshot_date",
    "total_value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
