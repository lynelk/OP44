{
  "name": "RevenueTransaction",
  "type": "object",
  "properties": {
    "transaction_type": {
      "type": "string",
      "enum": [
        "rental_fee",
        "loan_disbursement_fee",
        "p2p_investment_fee",
        "insurance_premium",
        "sms_fee",
        "whatsapp_fee",
        "crb_fee",
        "validation_fee",
        "transaction_fee",
        "partner_fee",
        "other"
      ]
    },
    "product_type": {
      "type": "string",
      "enum": [
        "rental",
        "loan",
        "p2p_loan",
        "insurance",
        "savings",
        "other"
      ]
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "UGX"
    },
    "partner_id": {
      "type": "string",
      "description": "lender_id or partner user_id"
    },
    "reference_id": {
      "type": "string",
      "description": "Links to rental_id, loan_id, etc."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "completed"
    },
    "fee_breakdown_json": {
      "type": "string",
      "description": "JSON string with detailed fee breakdown"
    },
    "transaction_date": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "transaction_type",
    "product_type",
    "amount",
    "transaction_date"
  ]
}