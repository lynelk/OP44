{
  "name": "UserSavingsChallenge",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    },
    "challenge_title": {
      "type": "string"
    },
    "challenge_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "failed",
        "abandoned"
      ],
      "default": "active"
    },
    "current_streak": {
      "type": "number",
      "default": 0
    },
    "longest_streak": {
      "type": "number",
      "default": 0
    },
    "total_saved_in_challenge": {
      "type": "number",
      "default": 0
    },
    "target_days": {
      "type": "number"
    },
    "target_amount": {
      "type": "number"
    },
    "daily_minimum": {
      "type": "number"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "last_saved_date": {
      "type": "string",
      "format": "date"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "badge_emoji": {
      "type": "string"
    },
    "badge_name": {
      "type": "string"
    },
    "pocket_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "challenge_id",
    "challenge_title",
    "challenge_type",
    "start_date"
  ]
}