{
  "name": "SavingsPocket",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "goal_amount": {
      "type": "number"
    },
    "current_balance": {
      "type": "number",
      "default": 0
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "icon": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "auto_save_amount": {
      "type": "number"
    },
    "auto_save_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "none"
      ],
      "default": "none"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "name",
    "goal_amount"
  ]
}