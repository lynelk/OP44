{
  "name": "InsuranceClaim",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "policy_id": {
      "type": "string"
    },
    "claim_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount_claimed": {
      "type": "number"
    },
    "amount_approved": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "approved",
        "rejected",
        "paid"
      ],
      "default": "submitted"
    },
    "supporting_docs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "File URLs"
    },
    "reviewer_notes": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "policy_id",
    "claim_type",
    "description",
    "amount_claimed"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
