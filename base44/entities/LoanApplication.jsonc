{
  "name": "LoanApplication",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "amount_requested": {
      "type": "number"
    },
    "amount_approved": {
      "type": "number"
    },
    "purpose": {
      "type": "string"
    },
    "tenure_months": {
      "type": "number"
    },
    "interest_rate": {
      "type": "number"
    },
    "risk_band": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "default": "C"
    },
    "credit_score_at_application": {
      "type": "number"
    },
    "risk_band_at_application": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "approved",
        "rejected",
        "disbursed",
        "active",
        "closed",
        "defaulted",
        "flagged"
      ],
      "default": "draft"
    },
    "monthly_installment": {
      "type": "number"
    },
    "total_repayable": {
      "type": "number"
    },
    "disbursed_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_repayment_date": {
      "type": "string",
      "format": "date"
    },
    "outstanding_balance": {
      "type": "number"
    },
    "restructured": {
      "type": "boolean",
      "default": false
    },
    "early_repayment_requested": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "admin_notes": {
      "type": "string"
    },
    "submitted_by_agent": {
      "type": "boolean",
      "default": false
    },
    "disbursement_fee": {
      "type": "number",
      "description": "Fee deducted from disbursed amount (3% of loan)"
    },
    "insurance_cost": {
      "type": "number",
      "description": "Loan protection insurance (1% of loan)"
    },
    "net_disbursement": {
      "type": "number",
      "description": "Actual amount received after fees"
    },
    "reminder_count": {
      "type": "number",
      "default": 0,
      "description": "Number of overdue reminders sent"
    },
    "last_reminder_sent_date": {
      "type": "string",
      "format": "date-time"
    },
    "escalated_to_collections": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "amount_requested",
    "tenure_months"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
