{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "in_app": {
      "type": "boolean",
      "default": true
    },
    "sms": {
      "type": "boolean",
      "default": true
    },
    "push": {
      "type": "boolean",
      "default": false
    },
    "email": {
      "type": "boolean",
      "default": false
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": false
    },
    "quiet_start": {
      "type": "string",
      "default": "22:00",
      "description": "Quiet hours start, HH:MM 24h"
    },
    "quiet_end": {
      "type": "string",
      "default": "07:00",
      "description": "Quiet hours end, HH:MM 24h"
    },
    "muted_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Notification.type values the user has muted"
    },
    "device_tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "web",
              "android",
              "ios"
            ]
          },
          "registered_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Registered push tokens for Web Push / FCM"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}