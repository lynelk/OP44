{
  "name": "ROSCAMember",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "payout_position": {
      "type": "number"
    },
    "total_contributed": {
      "type": "number",
      "default": 0
    },
    "has_received_payout": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "defaulted",
        "exited"
      ],
      "default": "active"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "group_id",
    "user_id"
  ]
}