{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "employment_status": {
      "type": "string",
      "enum": [
        "employed",
        "self_employed",
        "unemployed",
        "student",
        "retired"
      ],
      "description": "Current employment status of the user"
    },
    "monthly_income": {
      "type": "number",
      "description": "Declared monthly income in local currency"
    },
    "current_credit_score": {
      "type": "number",
      "description": "Most recent calculated credit score (300-850)"
    },
    "current_risk_band": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Current risk band derived from credit score"
    },
    "phone_number": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "national_id": {
      "type": "string"
    },
    "address": {
      "type": "string"
    }
  }
}