# ─────────────────────────────────────────────────────────────────────────────
# Pipiya / OpFin — environment variables
# Copy to `.env` (git-ignored) and fill in. Frontend vars MUST be prefixed VITE_.
# Backend (Base44 function) secrets are configured in the Base44 console, not here
# — they're listed at the bottom for reference. See base44/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base44 app wiring (frontend) ──
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
# Optional: set to enable the local dev proxy to a Base44 backend
VITE_BASE44_APP_BASE_URL=

# ── Web Push (frontend) ──
# Public VAPID key used to subscribe the browser to push notifications.
# The matching private key lives in the Base44 console (see FCM/VAPID below).
VITE_VAPID_PUBLIC_KEY=

# ── Error tracking (frontend, optional) ──
# Leave blank to disable Sentry. When set, errors are reported in production builds.
VITE_SENTRY_DSN=
VITE_APP_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Base44 function secrets (configure in the Base44 console — NOT in this file).
# Listed here only so deployers know what the backend expects. Each integration
# degrades to a safe no-op when its secret is unset.
# ─────────────────────────────────────────────────────────────────────────────
# SMS (Africa's Talking):  AFRICASTALKING_API_KEY, AFRICASTALKING_USERNAME, AFRICASTALKING_SENDER
# USSD gateway:            USSD_GATEWAY_SECRET (shared secret; embed as ?gw_secret= in the AT callback URL or send as x-ussd-secret header. Leave unset to keep the endpoint open for the in-app simulator.)
# Push (FCM):              FCM_SERVER_KEY
# Email (Resend):          RESEND_API_KEY, NOTIFY_FROM_EMAIL
# Bank aggregator (Mono):  MONO_SECRET_KEY
# MTN MoMo:                MTN_MOMO_API_USER, MTN_MOMO_API_KEY, MTN_MOMO_SUBSCRIPTION_KEY, MTN_MOMO_BASE_URL
# Airtel Money:            AIRTEL_BASE_URL, AIRTEL_CLIENT_ID, AIRTEL_CLIENT_SECRET
